{
  "widgets": [
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "5xx Errors (Sum)",
        "metrics": [
          ["PulseBoard/pulseboard", "FiveXXCount", { "stat": "Sum", "period": 300 }]
        ],
        "view": "timeSeries",
        "region": "eu-central-1",
        "yAxis": { "left": { "min": 0 } }
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 0,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "API Latency (p99)",
        "metrics": [
          ["PulseBoard/pulseboard", "ApiLatency", { "stat": "p99", "period": 300 }]
        ],
        "view": "timeSeries",
        "region": "eu-central-1",
        "yAxis": { "left": { "min": 0, "max": 2000 } }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Running Pods",
        "metrics": [
          ["ContainerInsights", "pod_number_of_running_pods", "ClusterName", "pulseboard-cluster", { "stat": "Average", "period": 300 }]
        ],
        "view": "timeSeries",
        "region": "eu-central-1"
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 6,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "CPU Utilization",
        "metrics": [
          ["ContainerInsights", "node_cpu_utilization", "ClusterName", "pulseboard-cluster", { "stat": "Average", "period": 300 }]
        ],
        "view": "timeSeries",
        "region": "eu-central-1",
        "yAxis": { "left": { "min": 0, "max": 100 } }
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 12,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Recent Errors",
        "query": "SOURCE '/pulseboard/pulseboard' | fields @timestamp, @message | filter @message like /ERROR/ | sort @timestamp desc | limit 20",
        "region": "eu-central-1",
        "view": "table"
      }
    }
  ]
}
